# Get from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Your numeric Telegram user ID (message @userinfobot to get it).
# Restricts the bot to only you - leave unset and anyone who finds the bot can use it.
TELEGRAM_ALLOWED_USER_ID=
